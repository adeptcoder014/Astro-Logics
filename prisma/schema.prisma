generator client {
  provider = "prisma-client-js"
  output   = "../prisma-client/binaries"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UtilityType {
  HAIRSTYLE
  MAKEUP
  HOME_DECO
  LINKEDIN
  ASTROLOGY_BIRTH_CHART
  ASTROLOGY_READING
  ASTROLOGY_TRANSIT
  ASTROLOGY_COMPATIBILITY
}

enum GenerationMode {
  PRESETS
  CUSTOM
  MIX_PHOTO // For hairstyle utility
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  SOURCE_IMAGE
  RESULT_IMAGE
  REFERENCE_IMAGE
  DOCUMENT
}

enum FileStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  FAILED
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PricingPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
  LIFETIME
  ONE_TIME
}

// ============================================
// ASTROLOGY ENUMS
// ============================================

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum Planet {
  SUN
  MOON
  MERCURY
  VENUS
  MARS
  JUPITER
  SATURN
  URANUS
  NEPTUNE
  PLUTO
  // Lunar Nodes
  NORTH_NODE
  SOUTH_NODE
  // Other points
  ASCENDANT
  MIDHEAVEN
  DESCENDANT
  IC
}

enum House {
  HOUSE_1
  HOUSE_2
  HOUSE_3
  HOUSE_4
  HOUSE_5
  HOUSE_6
  HOUSE_7
  HOUSE_8
  HOUSE_9
  HOUSE_10
  HOUSE_11
  HOUSE_12
}

enum AspectType {
  CONJUNCTION
  SEXTILE
  SQUARE
  TRINE
  OPPOSITION
  QUINCUNX
  SEMISEXTILE
  SEMISQUARE
  SESQUIQUADRATE
  QUINTILE
  BIQUINTILE
}

enum AspectOrb {
  TIGHT     // 0-1 degree
  MEDIUM    // 1-3 degrees
  WIDE      // 3-7 degrees
  VERY_WIDE // 7+ degrees
}

enum PlanetElement {
  FIRE
  EARTH
  AIR
  WATER
}

enum PlanetQuality {
  CARDINAL
  FIXED
  MUTABLE
}

enum ChartType {
  NATAL        // Birth chart
  TRANSIT      // Current planetary positions
  PROGRESSION  // Secondary progression
  SOLAR_RETURN // Solar return chart
  LUNAR_RETURN // Lunar return chart
  COMPOSITE    // Relationship composite
  SYNASTRY     // Comparison chart
}

enum ReadingType {
  PERSONALITY_PROFILE
  CAREER_GUIDANCE
  RELATIONSHIP_COMPATIBILITY
  LIFE_CHALLENGES
  SPIRITUAL_PATH
  HEALTH_WELLNESS
  FINANCIAL_PROSPERITY
  TIMING_FORECAST
  COMPREHENSIVE_ANALYSIS
}

enum ReadingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CoordinateSystem {
  SIDEREAL
  TROPICAL
}

enum TimeResolution {
  MINUTE
  SECOND
  EVENT_BASED
}

enum PlanetDirection {
  DIRECT
  RETROGRADE
  STATIONARY
}

// ============================================
// MODELS
// ============================================

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  mobile         String?  @unique // Optional for Google OAuth users
  email          String   @unique
  passwordHash   String? // For future password auth
  avatar         String? // Profile picture URL
  isActive       Boolean  @default(true)
  isDeleted      Boolean  @default(false)
  emailVerified  Boolean  @default(false)
  mobileVerified Boolean  @default(false)
  lastLoginAt    DateTime?

  // Usage Statistics
  totalGenerations Int @default(0)
  totalStorageUsed  Int @default(0) // Bytes

  // Relations
  subscriptions    Subscription[]
  aiGenerations    AIGeneration[]
  uploadedFiles    UploadedFile[]
  usageLogs         UsageLog[]
  preferences      UserPreferences?
  accounts         Account[]
  sessions         Session[]

  // Astrology Relations
  birthCharts      BirthChart[]
  astrologyReadings AstrologyReading[]
  transitCharts    TransitChart[]
  nativityCharts   NativityChart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isDeleted])
  @@index([createdAt])
}

model AIGeneration {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Utility Type
  utilityType UtilityType

  // Generation Mode
  mode GenerationMode

  // Status
  status       GenerationStatus @default(PENDING)
  errorMessage String?

  // File References
  sourceImageId    String?        @db.ObjectId
  sourceImage      UploadedFile?   @relation("SourceImage", fields: [sourceImageId], references: [id])
  resultImageId    String?         @db.ObjectId
  resultImage      UploadedFile?   @relation("ResultImage", fields: [resultImageId], references: [id])
  referenceImageId String?         @db.ObjectId
  referenceImage   UploadedFile?   @relation("ReferenceImage", fields: [referenceImageId], references: [id])

  // Prompt Metadata
  presetId    String? // Preset identifier
  presetLabel String? // Human-readable preset name
  customPrompt String? // Custom user prompt

  // Utility-Specific Fields
  // For Home Deco
  roomType String? // e.g., "Living Room", "Bedroom"
  goal     String? // e.g., "style-transformation", "smart-layout", "space-conversion"

  // For LinkedIn
  gender   String? // "male" or "female"
  category String? // "academic", "elegant", "traditionalist", "classic"

  // Gemini API Response Data
  model          String?  @default("gemini-2.5-flash-image")
  promptUsed     String? // Full prompt sent to API
  apiResponse    Json? // Full API response for debugging
  processingTime Int? // Milliseconds

  // Cost Tracking
  creditsConsumed Float? @default(0)
  estimatedCost   Float? // USD

  // User Feedback
  rating  Int? // 1-5 stars
  comment String?

  // Sharing
  isPublic Boolean @default(false)
  shareId  String? @unique // For public sharing URLs

  // Metadata
  tags String[]

  // Relations
  usageLogs UsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([userId, utilityType])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([utilityType, status])
  @@index([status])
}

model UploadedFile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // File Metadata
  fileName  String
  fileSize  Int // Bytes
  mimeType  String
  fileType  FileType
  status    FileStatus @default(UPLOADING)

  // Storage Location
  storagePath String? // GCS bucket path
  storageUrl  String? // Public URL if available
  gcsBucket   String? // GCS bucket name

  // Image Metadata (if applicable)
  width    Int?
  height   Int?
  format   String? // jpeg, png, etc.

  // Relations
  sourceGenerations    AIGeneration[] @relation("SourceImage")
  resultGenerations    AIGeneration[] @relation("ResultImage")
  referenceGenerations AIGeneration[] @relation("ReferenceImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploadedAt DateTime?

  @@index([userId, fileType])
  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Plan Details
  planType PlanType
  pricingPlanId String? @db.ObjectId
  pricingPlan   PricingPlan? @relation(fields: [pricingPlanId], references: [id])

  // Subscription Status
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(false)

  // Usage Limits (per month)
  maxGenerationsPerMonth Int? // Null = unlimited
  maxGenerationsPerDay   Int? // Null = unlimited
  maxStorageMB           Int? // MB, Null = unlimited

  // Utility-Specific Limits
  maxHairstyleGenerations Int? // Per month
  maxMakeupGenerations    Int? // Per month
  maxHomeDecoGenerations  Int? // Per month
  maxLinkedInGenerations  Int? // Per month

  // Astrology Limits
  maxBirthChartGenerations Int? // Per month
  maxAstrologyReadings     Int? // Per month
  maxTransitCharts         Int? // Per month
  maxCompatibilityCharts   Int? // Per month

  // Feature Flags
  features String[] // Array of enabled features
  // e.g., "custom-prompts", "batch-processing", "high-resolution", "priority-processing"

  // Payment
  price         Float?
  currency      String?   @default("USD")
  paymentMethod String?
  paymentId     String? // Razorpay payment ID
  lastPaymentAt DateTime?

  // Billing
  billingCycle String? // "monthly", "yearly"
  nextBillingDate DateTime?

  // Relations
  usageLogs UsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, planType])
  @@index([status])
  @@index([endDate])
}

model UsageLog {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  subscriptionId String?       @db.ObjectId
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  generationId String?        @db.ObjectId
  generation   AIGeneration?  @relation(fields: [generationId], references: [id])

  // Usage Details
  utilityType     UtilityType
  action          String // "generation", "upload", "download"
  creditsConsumed Float  @default(0)
  cost            Float? // USD

  // Rate Limiting
  ipAddress String?
  userAgent String?

  // Metadata
  metadata Json? // Additional context

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, utilityType])
  @@index([subscriptionId, createdAt])
  @@index([generationId])
  @@index([createdAt])
}

model UserPreferences {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Default Settings per Utility
  defaultHairstyleMode GenerationMode?
  defaultMakeupMode    GenerationMode?
  defaultHomeDecoMode  GenerationMode?
  defaultLinkedInMode  GenerationMode?

  // Astrology Preferences
  defaultReadingTypes     ReadingType[] // Preferred types of readings
  birthTimeFormat         String?       @default("12h") // "12h" or "24h"
  zodiacSystem            String?       @default("tropical") // "tropical" or "sidereal"
  houseSystem             String?       @default("placidus") // "placidus", "equal", "whole_sign", etc.
  preferredAspects        AspectType[]  // Which aspects to emphasize
  showMinorAspects        Boolean       @default(false)
  notifyOnSignificantTransits Boolean   @default(true)

  // Favorite Presets
  favoriteHairstylePresets String[] // Array of preset IDs
  favoriteMakeupPresets    String[]
  favoriteHomeDecoPresets  String[]
  favoriteLinkedInPresets  String[]

  // UI Preferences
  theme            String?  @default("light") // "light", "dark", "auto"
  language         String?  @default("en")
  showTutorials    Boolean  @default(true)
  autoSaveHistory  Boolean  @default(true)

  // Notification Settings
  emailNotifications Boolean @default(false)
  pushNotifications  Boolean @default(false)
  notifyOnCompletion Boolean @default(true)

  // Privacy Settings
  defaultSharePublic Boolean @default(false)

  // Advanced Settings
  preferredImageQuality String? @default("standard") // "standard", "high", "ultra"
  autoDeleteOldFiles    Boolean @default(false)
  fileRetentionDays     Int?    @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ASTROLOGY MODELS
// ============================================

model BirthChart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Chart Metadata
  chartType ChartType @default(NATAL)
  chartName String?   // Custom name for the chart

  // Birth Information
  birthDate      DateTime
  birthTime      String?  // HH:MM format
  birthTimezone  String?  // e.g., "America/New_York"
  birthLocation  String?   // City, Country
  latitude       Float    // Decimal degrees
  longitude      Float    // Decimal degrees
  altitude       Float?   // Meters above sea level

  // Chart Data (calculated)
  sunSign       ZodiacSign?
  moonSign      ZodiacSign?
  risingSign    ZodiacSign?
  moonPhase     String?     // e.g., "New Moon", "Full Moon"
  lunarDay      Int?        // 1-30

  // Chart Status
  isCalculated  Boolean    @default(false)
  calculationError String?

  // Relations
  planets       PlanetPosition[]
  houses        HousePosition[]
  aspects       Aspect[]
  readings      AstrologyReading[]
  transitCharts TransitChart[]

  // Metadata
  notes         String?
  isPublic      Boolean    @default(false)
  shareId       String?    @unique // For public sharing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calculatedAt DateTime?

  @@index([userId])
  @@index([chartType])
  @@index([isCalculated])
  @@index([createdAt])
}

model PlanetPosition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  birthChartId String @db.ObjectId
  birthChart  BirthChart @relation(fields: [birthChartId], references: [id], onDelete: Cascade)

  planet      Planet
  zodiacSign  ZodiacSign
  degree      Float?       // 0-359.99 degrees
  minutes     Float?       // 0-59.99 minutes
  seconds     Float?       // 0-59.99 seconds

  // House position
  house       House?
  houseDegree Float?      // Degree within the house

  // Speed and direction
  speed       Float?      // Degrees per day
  isRetrograde Boolean    @default(false)

  // Element and Quality
  element     PlanetElement?
  quality     PlanetQuality?

  // Dignities
  isDomicile      Boolean @default(false)
  isExaltation    Boolean @default(false)
  isDetriment     Boolean @default(false)
  isFall          Boolean @default(false)

  // Essential Dignities Score (0-5)
  dignityScore    Float   @default(0)

  createdAt DateTime @default(now())

  @@index([birthChartId])
  @@index([planet])
  @@unique([birthChartId, planet])
}

model HousePosition {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  birthChartId String @db.ObjectId
  birthChart  BirthChart @relation(fields: [birthChartId], references: [id], onDelete: Cascade)

  house       House
  zodiacSign  ZodiacSign
  degree      Float   // 0-359.99 degrees

  // Size in degrees
  size        Float?

  // Planets in this house
  planets     Planet[] // Array of planets in this house

  createdAt DateTime @default(now())

  @@index([birthChartId])
  @@index([house])
  @@unique([birthChartId, house])
}

model Aspect {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  birthChartId String @db.ObjectId
  birthChart  BirthChart @relation(fields: [birthChartId], references: [id], onDelete: Cascade)

  // Planets involved
  planet1     Planet
  planet2     Planet

  // Aspect details
  aspectType  AspectType
  orb         Float       // Degrees of separation from perfect aspect
  orbQuality  AspectOrb   // Tight, medium, wide, very wide

  // Strength and influence
  strength    Float       @default(1) // 0-1 scale
  isApplying  Boolean     @default(false) // Aspect is getting tighter
  isSeparating Boolean    @default(false) // Aspect is getting wider

  // Interpretation flags
  isMajor     Boolean     @default(true)
  isHarmonic  Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([birthChartId])
  @@index([planet1, planet2])
  @@index([aspectType])
}

model AstrologyReading {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthChartId String? @db.ObjectId
  birthChart  BirthChart? @relation(fields: [birthChartId], references: [id])

  // Reading Details
  readingType ReadingType
  title       String
  status      ReadingStatus @default(PENDING)

  // Content
  summary     String?     // Brief overview
  introduction String?    // Opening paragraph
  mainContent Json?       // Structured content (sections, paragraphs)
  conclusion  String?     // Closing thoughts

  // Sections (stored as JSON for flexibility)
  personalityProfile Json? // Personality traits, strengths, weaknesses
  careerGuidance     Json? // Career paths, work style, professional life
  relationships      Json? // Love life, friendships, family dynamics
  lifeChallenges     Json? // Lessons to learn, obstacles to overcome
  spiritualPath      Json? // Soul purpose, spiritual growth, life lessons
  healthWellness     Json? // Health tendencies, wellness practices
  financialProsperity Json? // Money mindset, financial patterns
  timingForecast     Json? // Important periods, transits, progressions

  // AI Generation Details
  aiModel            String? // Which AI model generated this
  promptUsed         String? // The prompt sent to AI
  processingTime     Int?    // Milliseconds
  confidenceScore    Float?  // AI confidence in the reading (0-1)

  // User Interaction
  isFavorited        Boolean @default(false)
  userRating         Int?    // 1-5 stars
  userNotes          String? // User's personal notes about the reading

  // Sharing & Privacy
  isPublic           Boolean @default(false)
  shareId            String? @unique
  viewCount          Int     @default(0)

  // Metadata
  tags               String[]
  keywords           String[] // For search functionality

  // Error handling
  errorMessage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([birthChartId])
  @@index([readingType])
  @@index([status])
  @@index([isPublic])
  @@index([createdAt])
}

model TransitChart {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  userId      String  @db.ObjectId
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthChartId String @db.ObjectId
  birthChart  BirthChart @relation(fields: [birthChartId], references: [id])

  // Transit Date
  transitDate DateTime

  // Current planetary positions
  planets     TransitPlanetPosition[]

  // All transit aspects (distinguished by category)
  aspects       TransitAspect[]

  // Significant transits
  significantEvents Json? // Major transits, eclipses, etc.

  // AI Analysis
  aiAnalysis  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([birthChartId])
  @@index([transitDate])
}

model TransitPlanetPosition {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  transitChartId String @db.ObjectId
  transitChart  TransitChart @relation(fields: [transitChartId], references: [id], onDelete: Cascade)

  planet        Planet
  zodiacSign    ZodiacSign
  degree        Float
  isRetrograde  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([transitChartId])
  @@unique([transitChartId, planet])
}

model TransitAspect {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  transitChartId String @db.ObjectId
  transitChart  TransitChart @relation(fields: [transitChartId], references: [id], onDelete: Cascade)

  // Type of aspect: "natal" (transiting to natal) or "transit" (between transiting planets)
  aspectCategory String // "natal" or "transit"

  // Planets involved
  planet1       Planet // Transiting planet
  planet2       Planet // Natal or another transiting planet
  planet1Type   String // "transit" or "natal"
  planet2Type   String // "transit" or "natal"

  aspectType    AspectType
  orb           Float
  isApplying    Boolean @default(false)

  // Impact on natal chart
  significance  String? // "major", "moderate", "minor"
  themes        String[] // Life areas affected

  createdAt DateTime @default(now())

  @@index([transitChartId])
}

// ============================================
// NextAuth Models (Required for OAuth)
// ============================================

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // oauth, credentials, etc.
  provider          String // google, discord, etc.
  providerAccountId String // The provider account ID
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, token])
}

// ============================================
// PRICING PLAN MODEL
// ============================================

model PricingPlan {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String // e.g., "Free", "Basic", "Premium", "Enterprise"
  slug   String @unique // URL-friendly identifier

  // Plan Type (for backward compatibility with Subscription model)
  planType PlanType

  // Status
  status PricingPlanStatus @default(ACTIVE)
  isPopular Boolean @default(false) // Highlight as "Most Popular"
  displayOrder Int @default(0) // For sorting plans

  // Pricing
  price         Float // Base price
  currency      String @default("USD")
  billingPeriod BillingPeriod // MONTHLY, YEARLY, LIFETIME, ONE_TIME
  originalPrice Float? // For showing discounts
  discount      Float? // Discount percentage or amount

  // Description & Marketing
  shortDescription String? // Short tagline
  longDescription  String? // Detailed description
  ctaText          String? @default("Get Started") // Call-to-action button text
  ctaLink          String? // Link for CTA button

  // Usage Limits
  maxGenerationsPerMonth Int? // Null = unlimited
  maxGenerationsPerDay   Int? // Null = unlimited
  maxStorageMB           Int? // MB, Null = unlimited

  // Utility-Specific Limits
  maxHairstyleGenerations Int? // Per month
  maxMakeupGenerations    Int? // Per month
  maxHomeDecoGenerations  Int? // Per month
  maxLinkedInGenerations  Int? // Per month

  // Astrology Limits
  maxBirthChartGenerations Int? // Per month
  maxAstrologyReadings     Int? // Per month
  maxTransitCharts         Int? // Per month
  maxCompatibilityCharts   Int? // Per month

  // Features
  features String[] // Array of feature descriptions
  // e.g., ["10 generations per month", "Basic AI utilities access", "Standard image quality"]

  // Feature Flags (for technical features)
  featureFlags String[] // Array of feature identifiers
  // e.g., ["custom-prompts", "batch-processing", "high-resolution", "priority-processing", "api-access", "white-label"]

  // Image Quality Settings
  allowedImageQualities String[] // ["standard", "high", "ultra"]
  defaultImageQuality   String?   @default("standard")

  // Support & Services
  supportLevel      String? // "community", "email", "priority", "dedicated"
  responseTime      String? // e.g., "24 hours", "4 hours", "1 hour"
  dedicatedSupport  Boolean @default(false)
  accountManager    Boolean @default(false)

  // Advanced Features
  apiAccess         Boolean @default(false)
  whiteLabel        Boolean @default(false)
  customIntegrations Boolean @default(false)
  batchProcessing   Boolean @default(false)
  priorityProcessing Boolean @default(false)

  // Trial & Setup
  trialDays         Int? // Number of free trial days
  setupFee          Float? // One-time setup fee
  requiresApproval  Boolean @default(false) // For enterprise plans

  // Restrictions
  maxUsers          Int? // For team/enterprise plans, null = unlimited
  maxProjects       Int? // Maximum number of projects/workspaces

  // Metadata
  tags              String[] // For categorization and filtering
  badge             String? // e.g., "Most Popular", "Best Value", "New"
  icon              String? // Icon URL or identifier
  color             String? // Hex color for UI theming

  // SEO & Marketing
  metaTitle         String?
  metaDescription   String?
  keywords          String[]

  // Relations
  subscriptions     Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planType])
  @@index([isPopular])
  @@index([displayOrder])
  @@index([createdAt])
}

// ============================================================================
// NATIVITY CHART MODELS
// ============================================================================

model NativityChart {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Chart identity
  name              String
  description       String?
  
  // Temporal index (TIME AS FIRST-CLASS INDEX)
  birthDateTime     DateTime
  birthTimestamp    BigInt   // Unix milliseconds for precise indexing
  timeResolution    TimeResolution @default(MINUTE)
  
  // Coordinate system governance
  coordinateSystem  CoordinateSystem @default(SIDEREAL)
  
  // Location (deterministic state resolution)
  latitude          Float
  longitude         Float
  timezone          String
  locationName      String?
  
  // Ephemeris lattice storage
  ephemerisData     EphemerisSnapshot?
  
  // Geometry-first indexing
  geometryIndex     GeometryIndex?
  
  // Planetary profiles
  planetaryProfiles PlanetaryProfile[]
  
  // Aspects and relationships
  aspects           NativityAspect[]
  
  // Memory & comparison system
  stateVectors      StateVector[]
  purposeStates     PurposeState[]
  similarities      SimilarityRecord[]
  
  // Current story & Rashoff Theatre
  currentStories    CurrentStory[]
  
  // Metadata
  isPublic          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId, birthTimestamp])
  @@index([coordinateSystem])
  @@index([birthDateTime])
}

model EphemerisSnapshot {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId   String   @unique @db.ObjectId
  nativityChart     NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Per-planet core storage
  planets           PlanetData[]
  
  // Indexing metadata
  absoluteTimeIndex BigInt   // Milliseconds since epoch
  phase             String?  // conjunction cycle, synodic phase
  
  createdAt         DateTime @default(now())
}

model PlanetData {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  ephemerisSnapshotId       String   @db.ObjectId
  ephemerisSnapshot         EphemerisSnapshot @relation(fields: [ephemerisSnapshotId], references: [id], onDelete: Cascade)
  
  // Planet identifier
  planet                    String   // SUN, MOON, MERCURY, VENUS, MARS, JUPITER, SATURN, URANUS, NEPTUNE, PLUTO, NODE
  
  // Positional data
  longitude                 Float    // Sidereal longitude
  latitude                  Float?   // If applicable
  
  // Velocity state (SIGNED)
  speed                     Float    // Degrees per day (signed: + direct, - retrograde)
  acceleration              Float?   // Optional but recommended
  
  // Direction states
  direction                 PlanetDirection @default(DIRECT)
  stationaryEnterTime       DateTime?
  stationaryExitTime        DateTime?
  
  // House mapping
  houseCusp                 Int?     // 1-12
  houseDegree               Float?
  houseSign                 String?
  
  // Relative angular index
  relativeAngularIndex      Float?   // For planet-planet relationships
  
  createdAt                 DateTime @default(now())
  
  @@index([ephemerisSnapshotId, planet])
  @@index([direction])
}

model GeometryIndex {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId   String   @unique @db.ObjectId
  nativityChart     NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Configuration vectors
  angularDistances  AngularDistance[]
  
  // Aspect normalization
  aspects           NativityAspect[]
  
  // Clustering metadata
  clusterHash       String?  // For geometry-based clustering
  
  createdAt         DateTime @default(now())
}

model AngularDistance {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  geometryIndexId String   @db.ObjectId
  geometryIndex   GeometryIndex @relation(fields: [geometryIndexId], references: [id], onDelete: Cascade)
  
  planet1         String
  planet2         String
  
  // Angular distance vector
  distance        Float    // Degrees
  minDistance     Float?   // Orb consideration
  maxDistance     Float?
  
  // Speed-weighted similarity
  speedWeighting  Float    @default(1.0)
  
  createdAt       DateTime @default(now())
  
  @@unique([geometryIndexId, planet1, planet2])
  @@index([geometryIndexId])
}

model NativityAspect {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String   @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  geometryIndexId String   @db.ObjectId
  geometryIndex   GeometryIndex @relation(fields: [geometryIndexId], references: [id], onDelete: Cascade)
  
  // Aspect definition
  planet1         String
  planet2         String
  aspectType      String   // conjunction, opposition, square, trine, sextile
  
  // Exactness & phase
  orbDistance     Float    // Degrees from exact
  isApplying      Boolean  // Applying vs separating
  exactnessScore  Float    @default(0.0) // 0-1
  
  // Aspect timing
  exactDateTime   DateTime?
  buildUpStart    DateTime?
  decayEnd        DateTime?
  
  // Orb & weighting rules
  orbStrength     Float    @default(1.0)
  speedWeighting  Float    @default(1.0)
  
  // Planetary profile integration
  planet1ProfileId String? @db.ObjectId
  planet1Profile  PlanetaryProfile? @relation("aspect_planet1", fields: [planet1ProfileId], references: [id])
  
  planet2ProfileId String? @db.ObjectId
  planet2Profile  PlanetaryProfile? @relation("aspect_planet2", fields: [planet2ProfileId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@index([nativityChartId, planet1, planet2])
  @@index([aspectType])
  @@index([isApplying])
}

model PlanetaryProfile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String   @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  planet          String
  
  // Domain authority mapping
  primaryDomain   String?
  secondaryDomain String?
  
  // Incentive model inputs
  dignity         String?  // Exalted, Domicile, Detriment, Fall
  strength        Float    @default(0.0) // 0-1 normalized
  speed           Float    // Degrees per day
  visibility      Float    @default(0.0) // 0-1
  
  // Planetary energy budget
  expressionBandwidth Float @default(1.0) // Finite bandwidth
  saturationLevel     Float @default(0.0) // Over-aspected detection
  distortionFactor    Float @default(0.0) // Saturation handling
  
  // Context schema
  housePosition   Int?     // 1-12
  signPosition    String?
  
  // Aspects this planet is involved in
  aspectsAsP1     NativityAspect[] @relation("aspect_planet1")
  aspectsAsP2     NativityAspect[] @relation("aspect_planet2")
  
  createdAt       DateTime @default(now())
  
  @@index([nativityChartId, planet])
}

model StateVector {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String   @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Temporal memory (NOT chat memory)
  timestamp       DateTime
  timestampMicro  BigInt   // Microsecond precision
  
  // Full state vector
  planetaryStates String   @db.String @default("[]") // JSON serialized PlanetData[]
  aspectStates    String   @db.String @default("[]") // JSON serialized Aspect[]
  
  // Attached metadata
  outcomes        String?  @db.String // JSON: outcome tags
  decisions       String?  @db.String // JSON: decision logs
  narratives      String?  @db.String // JSON: separate narrative layer
  
  // Hierarchical memory
  eventLayer      Boolean  @default(false)
  patternLayer    Boolean  @default(false)
  archetypeLayer  Boolean  @default(false)
  
  // Memory hygiene
  confidenceLevel Float    @default(1.0)
  entropyScore    Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  
  @@index([nativityChartId, timestamp])
  @@index([timestamp])
}

model PurposeState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String   @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Temporal anchor for purpose computation
  timestamp       DateTime
  timestampMicro  BigInt   // Microsecond precision
  
  // Source state data (inspired by StateVector)
  planetaryStates String   @db.String @default("[]") // JSON serialized PlanetData[]
  aspectStates    String   @db.String @default("[]") // JSON serialized Aspect[]
  outcomes        String?  @db.String // JSON: outcome tags
  decisions       String?  @db.String // JSON: decision logs
  narratives      String?  @db.String // JSON: narrative context
  
  // Computation inputs
  intentSignals   String   @db.String @default("[]") // JSON: intent / mission signals
  priorityWeights String   @db.String @default("{}") // JSON: weighted priorities
  constraintFlags String   @db.String @default("[]") // JSON: active constraints
  
  // Computed vector output
  purposeVector   String?  @db.String // JSON serialized purpose vector
  vectorVersion   String   @default("v1")
  computedAt      DateTime?
  
  // Quality metrics
  confidenceLevel Float    @default(1.0)
  entropyScore    Float    @default(0.0)
  
  createdAt       DateTime @default(now())
  
  @@index([nativityChartId, timestamp])
  @@index([timestamp])
  @@index([computedAt])
}

model SimilarityRecord {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId String   @db.ObjectId
  nativityChart   NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Geometry-based distance function
  similarTo       String   // Reference chart ID or timestamp
  similarityScore Float    // 0-1, geometric distance
  
  // Included in similarity
  speedWeighting  Boolean  @default(true)
  phaseWeighting  Boolean  @default(true)
  orbWeighting    Boolean  @default(true)
  
  // Query metadata
  queryType       String   // "past", "future", "similar_pattern"
  
  createdAt       DateTime @default(now())
  
  @@index([nativityChartId, similarityScore])
}
// ============================================================================
// CURRENT STORY MODELS - Rashoff Theatre
// ============================================================================

model CurrentStory {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nativityChartId   String   @db.ObjectId
  nativityChart     NativityChart @relation(fields: [nativityChartId], references: [id], onDelete: Cascade)
  
  // Current transit data
  transitDate       DateTime
  userLatitude      Float
  userLongitude     Float
  userTimeZone      String?
  
  // Planetary scenes (one per planet)
  scenes            PlanetaryScene[]
  
  // Current Story State - collective state modified by all planets
  storyState        Json // Contains comprehensive behavioral state analysis
  
  // AI generated plot twist
  mainNarrative     String   @db.String
  overallIntensity  Float
  themes            String[]
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime // Re-generate daily

  @@index([nativityChartId])
  @@index([transitDate])
}

model PlanetaryScene {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  currentStoryId    String   @db.ObjectId
  currentStory      CurrentStory @relation(fields: [currentStoryId], references: [id], onDelete: Cascade)

  // COMPUTED CORE
  planet            String
  sign              String
  house             Int
  natalLongitude    Float
  currentLongitude  Float
  movementDegrees   Float
  intensity         Float

  // PRIMARY DISTILLED PRESSURES
  dominantPressure  String?
  behavioralPattern String?
  externalConflict  String?
  relationshipEffect String?
  pressureDirection String?
  collapseRisk      Float?
  momentumDirection String?
  storyFunction     String?

  // TRANSIT DATA
  activeAspects     String[]

  // FULL STRUCTURED STATE
  sceneAttributes   Json?

  createdAt         DateTime @default(now())

  @@index([currentStoryId])
  @@index([planet])
}      